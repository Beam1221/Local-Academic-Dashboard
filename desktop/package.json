{
  "name": "studyspace-desktop",
  "version": "1.0.0",
  "description": "Your personal academic workspace",
  "author": "Studyspace",
  "private": true,
  "main": "main.cjs",
  "scripts": {"start": "electron .", "package": "electron-builder --win nsis --x64 --publish never"},
  "devDependencies": {"electron": "44.4.4", "electron-builder": "26.15.3"},
  "build": {
    "appId": "local.studyspace.desktop",
    "productName": "Studyspace",
    "electronDist": "node_modules/electron/dist",
    "directories": {"output": "../../windows-release"},
    "files": ["main.cjs", "icon.png", "package.json"],
    "extraResources": [
      {"from": "backend-dist/studyspace-backend", "to": "backend", "filter": ["**/*"]},
      {"from": "../frontend/dist", "to": "web", "filter": ["**/*"]}
    ],
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "icon": "icon.ico", "artifactName": "Studyspace-Setup-${version}-${arch}.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "deleteAppDataOnUninstall": false},
    "asar": true
  }
}
